package bloom:route@0.1.0;

interface types {
  record ctx {
    petal-root: string,
    package-hash: string,
    path: string,
    params: list<tuple<string, string>>,
    actor: option<string>,
  }

  enum entry-kind { dir, file, symlink }

  record entry {
    name: string,
    kind: entry-kind,
    mode: u32,
    size: option<u64>,
    link-target: option<string>,
  }

  variant route-error {
    not-found(string),
    not-a-dir(string),
    denied(string),
    invalid(string),
    backend(string),
    unsupported(string),
  }

  record route-meta {
    kind: entry-kind,
    mode: u32,
    cache-ttl-ms: option<u64>,
    side-effecting-read: bool,
    write-async: bool,
    description: option<string>,
    consent-summary: option<string>,
    required-caps: list<string>,
    sign-intent: option<string>,
    executable: bool,
  }
}
