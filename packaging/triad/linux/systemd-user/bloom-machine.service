[Unit]
Description=Bloom Machine daemon and mounted VFS
ConditionPathExists=/etc/bloom/%U/edge-manifest.json
Wants=bloom-session.service
After=bloom-session.service network-online.target

[Service]
Type=simple
Environment=BLOOM_NFS_LISTEN=127.0.0.1:18735
Environment=BLOOM_MOUNT_FROM_FSTAB=true
ExecStart=/usr/bin/bloom serve --mount %h/bloom
Restart=on-failure
RestartSec=5s
UMask=0077
RemoveIPC=yes
LimitCORE=0

[Install]
WantedBy=default.target
