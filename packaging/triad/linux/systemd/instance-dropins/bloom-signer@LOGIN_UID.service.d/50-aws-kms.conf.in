# The installer renders LOGIN_UID in this directory name and installs the
# result as bloom-signer@<uid>.service.d/50-aws-kms.conf only for that
# AWS-KMS-enabled Signer instance.
# @AWS_KMS_IP_ALLOW_DIRECTIVES@ must contain one or more reviewed
# "IPAddressAllow=CIDR" lines and must never contain "any".
[Service]
PrivateNetwork=no
RestrictAddressFamilies=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
@AWS_KMS_IP_ALLOW_DIRECTIVES@
LoadCredential=aws-credentials:/etc/bloom/%i/signer/aws-credentials
